# Dockerfile.cuda — GPU-accelerated VMAF with libvmaf_cuda

# Global ARGs — available to all stages via empty redeclaration
ARG FFMPEG_version=8.1
ARG VMAF_version=3.2.1
ARG DAV1D_version=1.4.3
ARG NVCODEC_version=13.0.19.1
ARG EASYVMAF_VERSION=5.0.0

FROM nvidia/cuda:12.8.2-devel-ubuntu22.04 AS base-cuda

FROM base-cuda AS build-cuda

ARG FFMPEG_version
ARG VMAF_version
ARG DAV1D_version
ARG NVCODEC_version

RUN apt-get update -yqq && \
    apt-get install --no-install-recommends \
        python3 python3-pip git \
        ninja-build wget doxygen autoconf automake cmake \
        g++ gcc pkg-config make nasm xxd yasm -y && \
    apt-get autoremove -y && \
    apt-get clean -y && \
    pip3 install meson

# Install NVIDIA Video Codec SDK headers (required by --enable-ffnvcodec)
# These are separate from the CUDA toolkit — maintained by VideoLAN. Pinned:
# libvmaf 3.2.1's CUDA code needs the functions added in 13.0.19.1
# (cuMemFreeAsync, cuStreamCreateWithPriority, ...), and 13.1 (master) no
# longer builds FFmpeg 8.1's nvenc.c
WORKDIR /tmp/nv-codec
RUN git clone --depth 1 --branch n${NVCODEC_version} https://git.videolan.org/git/ffmpeg/nv-codec-headers.git && \
    cd nv-codec-headers && \
    make install && \
    rm -rf /tmp/nv-codec

# Build dav1d from source — Ubuntu 22.04 ships 0.9.2, FFmpeg 8.1 requires >= 1.0.0.
# Release tarball: code.videolan.org answers wget's archive requests with an HTML page
WORKDIR /tmp/dav1d
RUN wget https://downloads.videolan.org/pub/videolan/dav1d/${DAV1D_version}/dav1d-${DAV1D_version}.tar.xz && \
    tar -xJf dav1d-${DAV1D_version}.tar.xz && \
    cd dav1d-${DAV1D_version} && \
    meson build --buildtype release --libdir=lib && \
    ninja -vC build && \
    ninja -vC build install && \
    ldconfig && \
    rm -rf /tmp/dav1d

# Build libvmaf with CUDA support
# --libdir=lib pins the install to /usr/local/lib on all platforms (meson defaults
# to lib64 on 64-bit Linux, lib on macOS — this makes both identical)
WORKDIR /tmp/vmaf
RUN wget https://github.com/Netflix/vmaf/archive/v${VMAF_version}.tar.gz && \
    tar -xzf v${VMAF_version}.tar.gz && \
    cd vmaf-${VMAF_version}/libvmaf/ && \
    meson build --buildtype release \
        -Dbuilt_in_models=true \
        -Denable_cuda=true \
        -Denable_float=true \
        --libdir=lib && \
    ninja -vC build && \
    ninja -vC build install && \
    ldconfig && \
    mkdir -p /usr/local/share/model && \
    cp -R ../model/* /usr/local/share/model && \
    rm -rf /tmp/vmaf

# clang compiles FFmpeg's CUDA filters (scale_cuda, yadif_cuda, ...) with
# --enable-cuda-llvm. --enable-cuda-nvcc and --enable-libnpp are nonfree in
# FFmpeg's configure and would make the binary unredistributable. A separate
# layer, so the layers above stay cached
RUN apt-get update -yqq && \
    apt-get install --no-install-recommends clang -y && \
    apt-get clean -y

# Build FFmpeg with libvmaf + CUDA. libvmaf links no CUDA library (it loads
# CUDA at runtime through the ffnvcodec headers), so no CUDA SDK path is needed
WORKDIR /tmp/ffmpeg
RUN export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}" && \
    export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH}" && \
    echo "=== PKG_CONFIG_PATH ===" && echo "${PKG_CONFIG_PATH}" && \
    echo "=== libvmaf.pc ===" && find /usr/local -name "libvmaf.pc" && \
    echo "=== pkg-config libvmaf ===" && pkg-config --libs libvmaf 2>&1 || true && \
    wget https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n${FFMPEG_version}.tar.gz && \
    tar -xzf n${FFMPEG_version}.tar.gz && \
    cd FFmpeg-n${FFMPEG_version} && \
    ( ./configure \
        --enable-libvmaf \
        --enable-version3 \
        --enable-shared \
        --enable-libdav1d \
        --enable-ffnvcodec \
        --enable-cuda-llvm \
    || ( echo "=== ffbuild/config.log (last 80 lines) ===" && tail -80 ffbuild/config.log && exit 1 ) ) && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/ffmpeg

WORKDIR /app
COPY . /app/easyvmaf/

# base, not runtime: runtime adds 3.1 GB of CUDA libraries (cuBLAS, cuFFT, NPP,
# ...) that nothing here links. FFmpeg and libvmaf load libcuda and libnvcuvid,
# injected by the host driver, through the ffnvcodec headers
FROM nvidia/cuda:12.8.2-base-ubuntu22.04 AS release-cuda

ENV LD_LIBRARY_PATH="/usr/local/lib"
# NVDEC (--gpu decoding) needs the video capability; nvidia/cuda only sets
# compute,utility, and without it FFmpeg cannot load libnvcuvid.so.1
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

ARG FFMPEG_version
ARG VMAF_version
ARG EASYVMAF_VERSION

LABEL org.opencontainers.image.title="easyVmaf-cuda"
LABEL org.opencontainers.image.version="${EASYVMAF_VERSION}"
LABEL org.opencontainers.image.description="GPU-accelerated FFmpeg-based VMAF computation"
# easyVmaf, FFmpeg (--enable-version3, no --enable-gpl), libvmaf, dav1d
LABEL org.opencontainers.image.licenses="MIT AND LGPL-3.0-or-later AND BSD-2-Clause-Patent AND BSD-2-Clause"
LABEL org.opencontainers.image.source="https://github.com/gdavila/easyVmaf"
LABEL ffmpeg.version="${FFMPEG_version}"
LABEL libvmaf.version="${VMAF_version}"

RUN apt-get update -yqq && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip && \
    apt-get autoremove -y && \
    apt-get clean -y && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install ffmpeg-progress-yield

# Only what was built (FFmpeg, libvmaf, dav1d, VMAF models): /usr/local/cuda
# of the build stage is the CUDA devel toolkit (6.4 GB, nvcc, NPP, ...), not
# needed at runtime and not ours to redistribute
COPY --from=build-cuda /usr/local/lib /usr/local/lib/
COPY --from=build-cuda /usr/local/bin /usr/local/bin/
COPY --from=build-cuda /usr/local/share /usr/local/share/
COPY --from=build-cuda /app/easyvmaf /app/easyvmaf/

WORKDIR /app/easyvmaf
RUN python3 -m pip install --no-deps .

ENTRYPOINT ["python3", "-u", "-m", "easyvmaf"]
